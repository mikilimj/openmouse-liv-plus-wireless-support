@@ -0,0 +1,86 @@
+/** LIV Plus Wireless EY6A016, 2.4 GHz receiver. See docs/endorfy-testing.md. */
+import { vgnDecodeDpi, vgnDecodePollingRate, vgnUnpackScalar } from "../vgn/index.js";
+export const ENDORFY_VENDOR_ID = 0x3299;
+export const ENDORFY_LIV_PLUS_RECEIVER_PID = 0x00a7;
+export const ENDORFY_REPORT_ID = 8;
+export const ENDORFY_PACKET_LENGTH = 16;
+export const ENDORFY_USAGE_PAGE = 0xff02;
+export const ENDORFY_USAGE = 2;
+export const ENDORFY_POLLING_RATES: readonly number[] = [125, 250, 500, 1000];
+export const ENDORFY_MAX_STAGES = 6;
+
+export function endorfyDecodeSettingsHeader(data: Uint8Array) {
+  if (data.length !== 6) throw new Error("Truncated Endorfy settings header.");
+  const scalar = (offset: number): number => {
+    const value = vgnUnpackScalar(data[offset]!, data[offset + 1]!);
+    if (value === null) throw new Error("The Endorfy mouse returned corrupt settings.");
+    return value;
+  };
+  const pollingRateHz = vgnDecodePollingRate(scalar(0));
+  const stageCount = scalar(2);
+  const activeStage = scalar(4);
+  if (pollingRateHz === null || !ENDORFY_POLLING_RATES.includes(pollingRateHz)
+    || stageCount < 1 || stageCount > ENDORFY_MAX_STAGES || activeStage >= stageCount) {
+    throw new Error("The Endorfy mouse returned unsupported settings.");
+  }
+  return { pollingRateHz, stageCount, activeStage };
+}
+
+export function endorfyDecodeDpiStage(data: Uint8Array): number {
+  const dpi = vgnDecodeDpi(data);
+  if (data.length !== 4 || dpi === null || dpi > 26000
+    || (data[2]! & 0x33) !== 0 || ((data[2]! >> 6) & 3) !== ((data[2]! >> 2) & 3)) {
+    throw new Error("The Endorfy mouse returned a corrupt DPI stage.");
+  }
+  return dpi;
+}
+
+/** RGB light-strip block, confirmed against the vendor's HIDUsb parser. */
+export const ENDORFY_LIGHTING_ADDRESS = 0xa0;
+export const ENDORFY_LIGHTING_MODES = [
+  "Off", "Wave", "Breathing single", "Static", "Neon", "Breathing Loop", "Multicolor static",
+] as const;
+export interface EndorfyLighting {
+  mode: typeof ENDORFY_LIGHTING_MODES[number];
+  color: string;
+  speed: number;
+  brightness: number;
+}
+
+export function endorfyDecodeLighting(data: Uint8Array): EndorfyLighting {
+  if (data.length !== 9) throw new Error("Truncated Endorfy lighting settings.");
+  if ((data.slice(0, 7).reduce((sum, byte) => sum + byte, 0) & 255) !== 0x55
+    || vgnUnpackScalar(data[7]!, data[8]!) === null) {
+    throw new Error("The Endorfy mouse returned corrupt lighting settings.");
+  }
+  const mode = ENDORFY_LIGHTING_MODES[data[0]!];
+  if (!mode || data[4]! > 9 || data[5]! > 9 || data[7]! > 1) {
+    throw new Error("The Endorfy mouse returned unsupported lighting settings.");
+  }
+  return {
+    mode: data[7] === 0 ? "Off" : mode,
+    color: `#${[...data.slice(1, 4)].map(byte => byte.toString(16).padStart(2, "0")).join("")}`,
+    speed: data[4]! + 1,
+    brightness: (data[5]! + 1) * 10,
+  };
+}
+
+export function endorfyEncodeLighting(lighting: EndorfyLighting): Uint8Array {
+  const mode = ENDORFY_LIGHTING_MODES.indexOf(lighting.mode);
+  if (mode < 0) throw new Error("Unsupported Endorfy lighting effect.");
+  if (typeof lighting.color !== "string" || !/^#[0-9a-f]{6}$/i.test(lighting.color)) {
+    throw new Error("Endorfy lighting color must be #rrggbb.");
+  }
+  if (!Number.isInteger(lighting.speed) || lighting.speed < 1 || lighting.speed > 10) {
+    throw new Error("Endorfy lighting speed must be 1–10.");
+  }
+  if (!Number.isInteger(lighting.brightness) || lighting.brightness < 10
+    || lighting.brightness > 100 || lighting.brightness % 10 !== 0) {
+    throw new Error("Endorfy lighting brightness must be 10–100% in steps of 10%.");
+  }
+  const rgb = [1, 3, 5].map(offset => Number.parseInt(lighting.color.slice(offset, offset + 2), 16));
+  const data = Uint8Array.from([mode, ...rgb, lighting.speed - 1, lighting.brightness / 10 - 1, 0, mode === 0 ? 0 : 1, 0]);
+  data[6] = (0x55 - data.slice(0, 6).reduce((sum, byte) => sum + byte, 0)) & 255;
+  data[8] = 0x55 - data[7]!;
+  return data;
+}
