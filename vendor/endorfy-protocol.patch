@@ -0,0 +1,20 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { endorfyDecodeDpiStage, endorfyDecodeSettingsHeader } from "../../endorfy/index.ts";
+
+test("decodes the upper DPI range using both high bits", () => {
+  assert.equal(endorfyDecodeDpiStage(new Uint8Array([7,7,136,191])), 26000);
+  assert.equal(endorfyDecodeDpiStage(new Uint8Array([0,0,68,17])), 12850);
+});
+
+test("rejects inconsistent axes, unsupported flags and damaged stage checksums", () => {
+  for (const packet of [[8,7,0,70], [8,8,1,68], [8,8,4,65], [8,8,0,0], [8,8,0]]) {
+    assert.throws(() => endorfyDecodeDpiStage(new Uint8Array(packet)), /corrupt/);
+  }
+});
+
+test("rejects invalid counts, active stages, rates and truncated settings", () => {
+  for (const header of [[1,84,0,85,0,85], [1,84,7,78,0,85], [1,84,1,84,1,84], [64,21,1,84,0,85], [1,84]]) {
+    assert.throws(() => endorfyDecodeSettingsHeader(new Uint8Array(header)));
+  }
+});
