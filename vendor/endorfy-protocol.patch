@@ -0,0 +1,62 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import * as codec from "./index.ts";
+
+// Receiver capture at flash 0xa0: red static light, speed 8, brightness level 1.
+const captured = Uint8Array.from([3,255,0,0,7,0,76,1,84]);
+
+test("decodes captured RGB settings without substituting defaults", () => {
+  assert.equal(typeof codec.endorfyDecodeLighting, "function");
+  assert.deepEqual(codec.endorfyDecodeLighting(captured), {
+    mode: "Static", color: "#ff0000", speed: 8, brightness: 10,
+  });
+});
+
+test("encodes RGB channels, level indexes and both independent checksums", () => {
+  assert.equal(typeof codec.endorfyEncodeLighting, "function");
+  assert.deepEqual([...codec.endorfyEncodeLighting({
+    mode: "Static", color: "#123456", speed: 4, brightness: 60,
+  })], [3,18,52,86,3,5,174,1,84]);
+});
+
+test("decodes every vendor effect and honors a disabled light strip", () => {
+  for (const [mode, want] of [
+    [0,"Off"], [1,"Wave"], [2,"Breathing single"], [3,"Static"],
+    [4,"Neon"], [5,"Breathing Loop"], [6,"Multicolor static"],
+  ] as const) {
+    const data = Uint8Array.from([mode,255,0,0,7,0,(0x55-mode-255-7)&255,1,84]);
+    assert.equal(codec.endorfyDecodeLighting(data).mode, want);
+  }
+  assert.equal(codec.endorfyDecodeLighting(Uint8Array.from([3,255,0,0,7,0,76,0,85])).mode, "Off");
+});
+
+test("encodes off and the brightness/speed endpoints", () => {
+  assert.deepEqual([...codec.endorfyEncodeLighting({mode:"Off",color:"#000000",speed:1,brightness:10})], [0,0,0,0,0,0,85,0,85]);
+  assert.deepEqual([...codec.endorfyEncodeLighting({mode:"Wave",color:"#ffffff",speed:10,brightness:100})], [1,255,255,255,9,9,69,1,84]);
+});
+
+test("rejects truncated or corrupt RGB blocks", () => {
+  assert.throws(() => codec.endorfyDecodeLighting(captured.slice(0,8)), /truncated/i);
+  for (const offset of [1,6,7,8]) {
+    const data = captured.slice(); data[offset]! ^= 1;
+    assert.throws(() => codec.endorfyDecodeLighting(data), /corrupt/i);
+  }
+});
+
+test("rejects valid-checksum RGB blocks with unsupported fields", () => {
+  for (const [offset, value] of [[0,7],[4,10],[5,10],[7,2]]) {
+    const data = captured.slice(); data[offset!] = value!;
+    data[6] = (0x55-data.slice(0,6).reduce((sum,byte)=>sum+byte,0))&255;
+    data[8] = (0x55-data[7]!)&255;
+    assert.throws(() => codec.endorfyDecodeLighting(data), /unsupported/i);
+  }
+});
+
+test("refuses unsupported effects, malformed colors, and unrepresentable levels", () => {
+  const base = {mode:"Static",color:"#123456",speed:4,brightness:60} as const;
+  for (const patch of [
+    {mode:"Spectrum"}, {mode:null}, {color:null}, {color:"#abc"}, {color:"#gg0000"},
+    {speed:0}, {speed:11}, {speed:1.5}, {speed:NaN},
+    {brightness:0}, {brightness:101}, {brightness:55}, {brightness:NaN},
+  ]) assert.throws(() => codec.endorfyEncodeLighting({...base,...patch} as never));
+});
